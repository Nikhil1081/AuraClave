PORT=10000
# Local development only: replace this with a private random value; never use it in production.
JWT_SECRET=replace-with-a-long-random-local-development-secret
# Optional until database-backed authentication cutover. Configure managed PostgreSQL outside source control.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_SSL=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=YOUR_PUBLIC_SERVER_IP
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
